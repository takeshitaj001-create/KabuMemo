@page "/"
@inject StockService StockSvc
@inject StockApiService ApiSvc
@inject NavigationManager Nav
@inject WatchListService WatchSvc
@inject WatchListStateService WatchState
@implements IDisposable

<PageTitle>株価メモ</PageTitle>

@if (showDeleteConfirm)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-box" @onclick:stopPropagation>
            @if (deleteIsLastList)
            {
                <h3 style="margin:0 0 12px;font-size:18px;">⚠ 銘柄を完全削除</h3>
                <p style="margin:0 0 20px;font-size:14px;">
                    「@deleteTargetCode」はどのリストにも属さなくなります。<br />
                    データも完全に削除されます。
                </p>
                <div class="d-flex gap-2 justify-content-end">
                    <button class="btn btn-secondary" @onclick="CancelDelete">キャンセル</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">完全削除する</button>
                </div>
            }
            else
            {
                <h3 style="margin:0 0 12px;font-size:18px;">リストから除外</h3>
                <p style="margin:0 0 4px;font-size:14px;">「@deleteTargetCode」をこのリストから除外します。</p>
                <p style="margin:0 0 20px;font-size:12px;color:#aaa;">※ 他のリストのデータは残ります。</p>
                <div class="d-flex gap-2 justify-content-end">
                    <button class="btn btn-secondary" @onclick="CancelDelete">キャンセル</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">除外する</button>
                </div>
            }
        </div>
    </div>
}

@if (showAddModal)
{
    <div class="modal-overlay" @onclick="CloseAddModal">
        <div class="modal-box" @onclick:stopPropagation>
            <h3 style="margin:0 0 12px;font-size:18px;">銘柄を追加</h3>

            <ul class="nav nav-tabs mb-3" style="font-size:14px;">
                <li class="nav-item">
                    <button class="nav-link @(addTab == 0 ? "active" : "")" @onclick="() => addTab = 0">名称で検索</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(addTab == 1 ? "active" : "")" @onclick="() => addTab = 1">コードで追加</button>
                </li>
            </ul>

            @if (addTab == 1)
            {
                <div class="mb-3">
                    <label class="form-label">銘柄コード</label>
                    <div class="d-flex gap-2">
                        <input class="form-control" @bind="newCode" placeholder="例: 7203" maxlength="10" />
                        <button class="btn btn-outline-secondary"
                                @onclick="SearchStockName"
                                disabled="@isSearchingName"
                                style="white-space:nowrap;min-width:72px;">
                            @(isSearchingName ? "検索中…" : "名称検索")
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(nameSearchError))
                    {
                        <div style="font-size:11px;color:#e03535;margin-top:4px;">@nameSearchError</div>
                    }
                </div>
                <div class="mb-3">
                    <label class="form-label">銘柄名</label>
                    <input class="form-control" @bind="newName" placeholder="例: トヨタ自動車" maxlength="50" />
                </div>
                <div class="mb-3">
                    <label class="form-label">追加先リスト</label>
                    <select class="form-select" @bind="addTargetListId">
                        @foreach (var list in WatchState.AllLists)
                        {
                            <option value="@list.Id">@list.Name</option>
                        }
                    </select>
                </div>
                @if (!string.IsNullOrEmpty(addError))
                {
                    <div class="alert alert-danger py-1 px-2 mb-3" style="font-size:13px;">@addError</div>
                }
                <div class="d-flex gap-2 justify-content-end">
                    <button class="btn btn-secondary" @onclick="CloseAddModal">キャンセル</button>
                    <button class="btn btn-primary" @onclick="AddStock">追加</button>
                </div>
            }
            else if (addTab == 0)
            {
                <div class="mb-3">
                    <label class="form-label">企業名・キーワード</label>
                    <div class="d-flex gap-2">
                        <input class="form-control"
                               value="@nameSearchQuery"
                               @oninput="e => nameSearchQuery = e.Value?.ToString() ?? string.Empty"
                               @onkeydown="OnNameSearchKeyDown"
                               placeholder="例: トヨタ、ソニー" />
                        <button class="btn btn-outline-primary"
                                @onclick="SearchByName"
                                disabled="@isSearchingByName"
                                style="white-space:nowrap;min-width:64px;">
                            @(isSearchingByName ? "検索中…" : "検索")
                        </button>
                    </div>
                </div>
                @if (nameSearchResults.Count > 0)
                {
                    <div class="list-group mb-3" style="max-height:220px;overflow-y:auto;font-size:13px;">
                        @foreach (var q in nameSearchResults)
                        {
                            var sym = q.Symbol ?? "";
                            var dispCode = sym.Contains('.') ? sym.Split('.')[0] : sym;
                            <button class="list-group-item list-group-item-action py-2"
                                    @onclick="() => SelectSearchResult(q)">
                                <span style="font-weight:600;color:#0066cc;">@dispCode</span>
                                <span style="margin-left:8px;">@(q.LongName ?? q.ShortName ?? sym)</span>
                                @if (!string.IsNullOrEmpty(q.ExchDisp))
                                {
                                    <span style="margin-left:6px;font-size:11px;color:#999;">@q.ExchDisp</span>
                                }
                            </button>
                        }
                    </div>
                }
                else if (nameSearchDone && !isSearchingByName)
                {
                    <div style="font-size:13px;color:#888;margin-bottom:12px;">該当する銘柄が見つかりませんでした。</div>
                }
                <div class="d-flex gap-2 justify-content-end">
                    <button class="btn btn-secondary" @onclick="CloseAddModal">キャンセル</button>
                </div>
            }
        </div>
    </div>
}


<div class="container-fluid px-3 py-3">
    <div class="toolbar">
        <h2 style="margin:0;font-size:14px;font-weight:700;">
            銘柄一覧 <span style="color:#0066cc;">@stocks.Count</span> 件
        </h2>
        <div class="d-flex gap-2 align-items-center">
            @if (isUpdatingPrices)
            {
                <span style="font-size:12px;color:#888;">
                    株価取得中 @updatedCount/@stocks.Count …
                </span>
            }
            else if (!string.IsNullOrEmpty(lastPriceUpdateTime))
            {
                <span style="font-size:11px;color:#aaa;">更新: @lastPriceUpdateTime</span>
            }
            @if (priceApiError)
            {
                <span style="font-size:11px;color:#e03535;" title="株価APIへのアクセスに失敗しました。CORS制約の可能性があります。">⚠️ 株価取得失敗</span>
            }
            <button class="btn-refresh" @onclick="UpdateAllPrices" disabled="@isUpdatingPrices">
                @(isUpdatingPrices ? "更新中…" : "📊 株価更新")
            </button>
            <button class="btn-add" @onclick="OpenAddModal">＋ 銘柄追加</button>
        </div>
    </div>

@if (WatchState.AllLists.Count == 0)
    {
        <div class="empty-state">
            <div style="font-size:48px;">📋</div>
            <p>まだリストが作成されていません。</p>
            <button class="btn-add" @onclick='() => Nav.NavigateTo("settings")'>⚙ 設定でリストを作成する</button>
        </div>
    }
    else if (stocks.Count == 0)
    {
        <div class="empty-state">
            <div style="font-size:48px;">📋</div>
            <p>このリストに銘柄がありません。</p>
            <button class="btn-add" @onclick="OpenAddModal">＋ 銘柄追加</button>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th style="width:70px;"></th>
                            <th style="width:40px;"></th>
                            <th style="width:200px;">銘柄</th>
                            <th style="width:150px;">現在値</th>
                            <th style="width:75px;">外部リンク</th>
                            <th>メモ</th>
                            <th style="width:150px;">アラーム日</th>
                            <th style="width:45px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < stocks.Count; i++)
                        {
                            var item = stocks[i];
                            var index = i;
                            <tr>
                                <td>
                                    <button class="btn-detail" @onclick="() => NavToDetail(item.Code)">詳細 ›</button>
                                </td>
                                <td>
                                    <div class="sort-btns">
                                        <button class="btn-sort" @onclick="() => MoveUp(index)" disabled="@(index == 0)">▲</button>
                                        <button class="btn-sort" @onclick="() => MoveDown(index)" disabled="@(index == stocks.Count - 1)">▼</button>
                                    </div>
                                </td>
                                <td>
                                    <div class="stock-code">@item.Code</div>
                                    <div class="stock-name">@item.Name</div>
                                </td>
                                <td>
                                    @if (item.CurrentPrice.HasValue)
                                    {
                                        <div class="price">¥@item.CurrentPrice.Value.ToString("N0")</div>
                                        <div class="change @item.PriceDirection">
                                            @(item.PriceDirection == "up" ? "▲" : item.PriceDirection == "down" ? "▼" : "—")
                                            @(item.PriceChange.HasValue ? Math.Abs(item.PriceChange.Value).ToString("N0") : "")
                                            @(item.PriceChangeRate.HasValue ? $"({(item.PriceChangeRate.Value >= 0 ? "+" : "")}{item.PriceChangeRate.Value:F2}%)" : "")
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.LastUpdated))
                                        {
                                            <div style="font-size:10px;color:#bbb;margin-top:2px;">@item.LastUpdated</div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="price" style="color:#bbb;">—</div>
                                        <div class="change flat" style="font-size:11px;color:#bbb;">未取得</div>
                                    }
                                </td>
                                <td>
                                    <div class="ext-link-col">
                                        <a class="btn-ext-link btn-ext-yahoo" href="https://finance.yahoo.co.jp/quote/@(item.Code)" target="_blank">Y!</a>
                                        <a class="btn-ext-link btn-ext-minkabu" href="https://minkabu.jp/stock/@item.Code" target="_blank">みん</a>
                                        <a class="btn-ext-link btn-ext-kabutan" href="https://kabutan.jp/stock/?code=@item.Code" target="_blank">株探</a>
                                    </div>
                                </td>
                                <td>
                                    <textarea class="memo-input" rows="2" placeholder="メモを入力…"
                                              value="@item.Memo"
                                              @oninput="e => item.Memo = e.Value?.ToString() ?? string.Empty"
                                              @onblur="SaveAsync"></textarea>
                                </td>
                                <td>
                                    <input type="date" class="date-input"
                                           value="@item.AlarmDate"
                                           @oninput="e => { item.AlarmDate = e.Value?.ToString(); }"
                                           @onblur="SaveAsync" />
                                </td>
                                <td>
                                    <button class="btn-delete" title="削除" @onclick="() => DeleteStock(item.Code)">🗑</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (errorLog.Count > 0)
    {
        <div class="error-log-panel">
            <div class="error-log-header">
                <span>⚠️ エラーログ（@errorLog.Count 件）</span>
                <button class="error-log-clear" @onclick="() => errorLog.Clear()">✕ クリア</button>
            </div>
            <div class="error-log-body">
                @foreach (var line in errorLog)
                {
                    <div class="error-log-line">@line</div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<StockItem> allStocks = [];
    private List<StockItem> stocks = [];
    private bool showAddModal = false;
    private int addTab = 0;
    private string newCode = "";
    private string newName = "";
    private string addError = "";
    private string addTargetListId = "";
    private string nameSearchError = "";
    private bool isSearchingName = false;

    private string nameSearchQuery = "";
    private bool isSearchingByName = false;
    private bool nameSearchDone = false;
    private List<YahooSearchQuote> nameSearchResults = [];

    private bool showDeleteConfirm = false;
    private string deleteTargetCode = "";
    private bool deleteIsLastList = false;

    private bool isUpdatingPrices = false;
    private bool priceApiError = false;
    private int updatedCount = 0;
    private string lastPriceUpdateTime = "";
    private List<string> errorLog = [];
    private bool _isInitialized = false;
    private bool _startupDone = false;

    protected override async Task OnInitializedAsync()
    {
        allStocks = await StockSvc.GetAllAsync();
        if (allStocks.Any(s => !string.IsNullOrEmpty(s.LastUpdated)))
        {
            var rawTime = allStocks.Where(s => s.LastUpdated != null).Max(s => s.LastUpdated) ?? "";
            if (DateTime.TryParseExact(rawTime, "yyyy-MM-dd HH:mm",
                    System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None, out var parsedTime))
                lastPriceUpdateTime = parsedTime.ToString("HH:mm");
            else
                lastPriceUpdateTime = rawTime;
        }
        ApplyFilter();
        WatchState.OnChange += OnWatchStateChanged;
        _isInitialized = true;
    }

    public void Dispose()
    {
        WatchState.OnChange -= OnWatchStateChanged;
    }

    private void OnWatchStateChanged()
    {
        ApplyFilter();
        InvokeAsync(StateHasChanged);
    }

    private void ApplyFilter()
    {
        var active = WatchState.ActiveList;
        if (active == null)
        {
            stocks = [];
            return;
        }
        var codes = active.StockCodes;
        stocks = codes
            .Select(c => allStocks.FirstOrDefault(s => s.Code == c))
            .Where(s => s != null)
            .Cast<StockItem>()
            .ToList();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        // OnInitializedAsync 完了後の最初のレンダリングで1回だけ起動
        if (_startupDone || !_isInitialized) return Task.CompletedTask;
        _startupDone = true;
        _ = AutoUpdateIfStaleAsync();
        return Task.CompletedTask;
    }

    private async Task AutoUpdateIfStaleAsync()
    {
        if (stocks.Count == 0) return;

        bool isStale;
        if (string.IsNullOrEmpty(lastPriceUpdateTime))
        {
            isStale = true;
        }
        else if (DateTime.TryParseExact(lastPriceUpdateTime, "yyyy-MM-dd HH:mm",
                     System.Globalization.CultureInfo.InvariantCulture,
                     System.Globalization.DateTimeStyles.None, out var lastUpdate))
        {
            isStale = (DateTime.Now - lastUpdate) >= TimeSpan.FromMinutes(30);
        }
        else
        {
            isStale = true;
        }

        if (isStale)
            await InvokeAsync(UpdateAllPrices);
    }


    // ---- 銘柄追加モーダル ----

    private void OpenAddModal()
    {
        if (WatchState.AllLists.Count == 0)
        {
            Nav.NavigateTo("settings");
            return;
        }
        addTab = 0;
        newCode = "";
        newName = "";
        addError = "";
        addTargetListId = WatchState.ActiveList?.Id ?? WatchState.AllLists.First().Id;
        nameSearchError = "";
        nameSearchQuery = "";
        nameSearchResults.Clear();
        nameSearchDone = false;
        showAddModal = true;
    }

    private void CloseAddModal() => showAddModal = false;

    private async Task SearchStockName()
    {
        var code = newCode.Trim();
        if (string.IsNullOrEmpty(code))
        {
            nameSearchError = "銘柄コードを入力してから検索してください。";
            return;
        }
        nameSearchError = "";
        isSearchingName = true;
        StateHasChanged();

        var name = await ApiSvc.FetchJapaneseNameAsync(code);

        isSearchingName = false;
        if (!string.IsNullOrEmpty(name))
        {
            newName = name;
            nameSearchError = "";
        }
        else
        {
            nameSearchError = "銘柄名を取得できませんでした。手動で入力してください。";
        }
        StateHasChanged();
    }

    private async Task SearchByName()
    {
        var q = nameSearchQuery.Trim();
        if (string.IsNullOrEmpty(q)) return;
        isSearchingByName = true;
        nameSearchDone = false;
        nameSearchResults.Clear();
        StateHasChanged();

        nameSearchResults = await ApiSvc.FetchSearchResultsAsync(q);
        isSearchingByName = false;
        nameSearchDone = true;
        StateHasChanged();
    }

    private async Task OnNameSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchByName();
    }

    private void SelectSearchResult(YahooSearchQuote q)
    {
        var sym = q.Symbol ?? "";
        newCode = sym.Contains('.') ? sym.Split('.')[0] : sym;
        newName = q.LongName ?? q.ShortName ?? "";
        addError = "";
        addTab = 1;
    }

    private async Task AddStock()
    {
        var code = newCode.Trim();
        var name = newName.Trim();
        if (string.IsNullOrEmpty(code))
        {
            addError = "銘柄コードを入力してください。";
            return;
        }
        var activeList = WatchState.AllLists.FirstOrDefault(l => l.Id == addTargetListId);
        if (activeList != null && activeList.StockCodes.Contains(code))
        {
            addError = $"銘柄コード「{code}」はこのリストに既に登録されています。";
            return;
        }
        if (string.IsNullOrEmpty(name))
        {
            isSearchingName = true;
            StateHasChanged();
            name = await ApiSvc.FetchJapaneseNameAsync(code) ?? "";
            isSearchingName = false;
        }
        // マスターに存在しない場合のみ追加
        if (!allStocks.Any(s => s.Code == code))
        {
            allStocks.Add(new StockItem { Code = code, Name = name });
            await StockSvc.SaveAsync(allStocks);
        }
        await WatchSvc.AddStockAsync(addTargetListId, code);
        var lists = await WatchSvc.GetAllAsync();
        WatchState.RefreshLists(lists);
        CloseAddModal();
    }

    // ---- 株価一括更新 ----

    private async Task UpdateAllPrices()
    {
        if (stocks.Count == 0) return;
        isUpdatingPrices = true;
        priceApiError = false;
        updatedCount = 0;
        errorLog.Clear();
        int failCount = 0;
        StateHasChanged();

        foreach (var item in stocks.ToList())
        {
            var result = await ApiSvc.FetchQuoteAsync(item.Code);
            if (result.Success && result.Quote != null)
            {
                var q = result.Quote;
                item.CurrentPrice = q.Close;
                item.PreviousClose = q.PreviousClose;
                item.PriceChange = q.Change;
                item.PriceChangeRate = q.ChangeRate;
                item.PriceDirection = q.Direction;
                item.OpenPrice = q.Open;
                item.HighPrice = q.High;
                item.LowPrice = q.Low;
                item.Volume = q.Volume;
                item.LastUpdated = q.LastUpdated;
                item.Exchange = q.Exchange;
                item.MarketCap = q.MarketCap;
                item.LotSize = q.LotSize;
                item.ForwardPE = q.ForwardPE;
                item.PriceToBook = q.PriceToBook;
                item.EPS = q.EPS;
                item.BPS = q.BPS;
                item.DividendYield = q.DividendYield;
                item.DividendRate = q.DividendRate;
                item.WeekHigh52 = q.WeekHigh52;
                item.WeekLow52 = q.WeekLow52;
            }
            else
            {
                failCount++;
                var ts = DateTime.Now.ToString("HH:mm:ss");
                errorLog.Add($"[{ts}] {result.Error}");
            }
            updatedCount++;
            StateHasChanged();
            await Task.Delay(200);
        }

        await StockSvc.SaveAsync(allStocks);
        lastPriceUpdateTime = DateTime.Now.ToString("HH:mm");
        priceApiError = failCount > 0;
        isUpdatingPrices = false;
        StateHasChanged();
    }

    // ---- その他操作 ----

    private async Task DeleteStock(string code)
    {
        deleteTargetCode = code;
        var activeId = WatchState.ActiveList?.Id ?? "";
        deleteIsLastList = !await WatchSvc.ExistsInOtherListAsync(activeId, code);
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        deleteTargetCode = "";
        deleteIsLastList = false;
    }

    private async Task ConfirmDelete()
    {
        var activeId = WatchState.ActiveList?.Id ?? "";
        await WatchSvc.RemoveStockAsync(activeId, deleteTargetCode);
        allStocks = await StockSvc.GetAllAsync();
        var lists = await WatchSvc.GetAllAsync();
        WatchState.RefreshLists(lists);
        showDeleteConfirm = false;
        deleteTargetCode = "";
        deleteIsLastList = false;
    }

    private async Task MoveUp(int index)
    {
        if (index <= 0) return;
        (stocks[index], stocks[index - 1]) = (stocks[index - 1], stocks[index]);
        var activeId = WatchState.ActiveList?.Id ?? "";
        await WatchSvc.UpdateOrderAsync(activeId, stocks.Select(s => s.Code).ToList());
        var lists = await WatchSvc.GetAllAsync();
        WatchState.RefreshLists(lists);
    }

    private async Task MoveDown(int index)
    {
        if (index >= stocks.Count - 1) return;
        (stocks[index], stocks[index + 1]) = (stocks[index + 1], stocks[index]);
        var activeId = WatchState.ActiveList?.Id ?? "";
        await WatchSvc.UpdateOrderAsync(activeId, stocks.Select(s => s.Code).ToList());
        var lists = await WatchSvc.GetAllAsync();
        WatchState.RefreshLists(lists);
    }

    private void NavToDetail(string code) => Nav.NavigateTo("stock/" + code);

    private async Task SaveAsync() => await StockSvc.SaveAsync(allStocks);

}
