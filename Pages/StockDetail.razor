@page "/stock/{Code}"
@inject StockService StockSvc
@inject StockApiService ApiSvc
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject GitHubService GhSvc

<PageTitle>@Code - KabuMemo</PageTitle>

<div class="container-fluid px-3 py-3">
    <div class="back-bar">
        <button class="btn-back" @onclick="GoBack">← 一覧に戻る</button>
        <span style="font-size:13px;color:#888;">一覧 › @Code @stock?.Name</span>
    </div>

    @if (stock == null)
    {
        <div class="alert alert-warning mt-3">銘柄コード「@Code」は見つかりませんでした。</div>
    }
    else
    {

        <div class="detail-header">
            <div class="stock-title">
                <h2 style="margin:0;font-size:22px;font-weight:700;color:#fff;">@stock.Code</h2>
                <p style="margin:4px 0 0;font-size:13px;color:#aab;">@stock.Name</p>
            </div>
            <div class="detail-price-block">
                @if (stock.CurrentPrice.HasValue)
                {
                    <div class="detail-price">¥@stock.CurrentPrice.Value.ToString("N0")</div>
                    <div class="detail-change @stock.PriceDirection">
                        @(stock.PriceDirection == "up" ? "▲" : stock.PriceDirection == "down" ? "▼" : "—")
                        @(stock.PriceChange.HasValue? Math.Abs(stock.PriceChange.Value).ToString("N0") : "")
                        @(stock.PriceChangeRate.HasValue ? $"({(stock.PriceChangeRate.Value >= 0 ? "+" :
          "")}{stock.PriceChangeRate.Value:F2}%)" : "")
                    </div>
                }
                else
                {
                    <div class="detail-price" style="color:#aab;">—</div>
                    <div class="detail-change flat">株価取得予定</div>
                }
            </div>
        </div>

        <div class="link-row">
            <a class="ext-link-box yahoo" href="@YahooUrl" target="_blank" rel="noopener noreferrer">
                <span class="link-logo">Y!</span>
                <span class="link-body">
                    <span class="link-label">ヤフーファイナンス<br /><strong>@Code @stock.Name</strong></span>
                    <span class="ext-badge">外部サイト・新しいタブで開く</span>
                </span>
                <span class="link-arrow">↗</span>
            </a>
            <a class="ext-link-box minkabu" href="@MinkabuUrl" target="_blank" rel="noopener noreferrer">
                <span class="link-logo">み</span>
                <span class="link-body">
                    <span class="link-label">みんかぶ<br /><strong>@Code @stock.Name</strong></span>
                    <span class="ext-badge">外部サイト・新しいタブで開く</span>
                </span>
                <span class="link-arrow">↗</span>
            </a>
            <a class="ext-link-box kabutan" href="@KabutanUrl" target="_blank" rel="noopener noreferrer">
                <span class="link-logo">株</span>
                <span class="link-body">
                    <span class="link-label">株探（かぶたん）<br /><strong>@Code @stock.Name</strong></span>
                    <span class="ext-badge">外部サイト・新しいタブで開く</span>
                </span>
                <span class="link-arrow">↗</span>
            </a>
        </div>

        <div class="detail-memo-card">
            <h3 style="margin:0 0 10px;font-size:15px;">メモ</h3>
            <textarea class="memo-input" rows="6" placeholder="この銘柄に関するメモを自由に入力できます…" style="width:100%;min-height:80px;"
                      value="@stock.Memo" @oninput="e => stock.Memo = e.Value?.ToString() ?? string.Empty"
                      @onblur="SaveAsync"></textarea>
            <div class="tag-row">
                <button class="tag-btn buy @(stock.IsBuyCandidate ? "on" : "off")" @onclick="ToggleBuy">購入検討</button>
                <button class="tag-btn hold @(stock.IsHolding ? "on" : "off")" @onclick="ToggleHold">保有中</button>
                <button class="tag-btn alarm @(IsAlarm ? "on" : "off")" disabled>⚠️ アラーム</button>
            </div>
            <div class="alarm-date-row">
                <label>アラーム日</label>
                <input type="date" class="date-input" value="@stock.AlarmDate"
                       @oninput="e => { stock.AlarmDate = e.Value?.ToString(); }" @onblur="SaveAsync" />
            </div>
        </div>

        <div class="detail-main-layout">
            <div class="detail-card card-basic">
                <h3>基本情報・参考指標</h3>
                <div class="info-grid">
                    <div class="info-section-label">市場情報</div>
                    <div class="info-row"><span class="label">市場</span><span class="value">@(stock.Exchange ?? "—")</span>
                    </div>
                    <div class="info-row"><span class="label">時価総額</span><span
                        class="value">@FormatMarketCap(stock.MarketCap)</span></div>
                        <div class="info-row"><span class="label">単元株数</span><span class="value">@(stock.LotSize.HasValue ?
                                                                                $"{stock.LotSize.Value:N0}株" : "—")</span></div>
                            <div class="info-row"><span class="label">最低購入代金</span><span
                                class="value">@FormatMinPurchase(stock.CurrentPrice, stock.LotSize)</span></div>

                                <div class="info-section-label">決算</div>
                                <div class="info-row">
                                    <span class="label">次回決算発表予定日</span>
                                    <span class="value"
                                          style="@EarningsDateStyle(stock.NextEarningsDate)">@FormatEarningsDate(stock.NextEarningsDate)</span>
                                </div>

                                <div class="info-section-label">株価指標</div>
                                <div class="info-row"><span class="label">PER（会社予想）</span><span
                                    class="value">@FormatDecimal(stock.ForwardPE, "倍")</span></div>
                                    <div class="info-row"><span class="label">PBR</span><span
                                        class="value">@FormatDecimal(stock.PriceToBook, "倍")</span></div>
                                        <div class="info-row"><span class="label">EPS（1株利益）</span><span class="value">@FormatDecimal(stock.EPS,
                                                                                             "円")</span></div>
                                            <div class="info-row"><span class="label">BPS（1株純資産）</span><span class="value">@FormatDecimal(stock.BPS,
                                                                                                           "円")</span></div>

                                                <div class="info-section-label">配当</div>
                                                <div class="info-row"><span class="label">配当利回り</span><span
                                                    class="value">@FormatPercent(stock.DividendYield)</span></div>
                                                    <div class="info-row"><span class="label">1株配当</span><span
                                                        class="value">@FormatDecimal(stock.DividendRate, "円")</span></div>

                                                        <div class="info-section-label">52週レンジ</div>
                                                        <div class="info-row"><span class="label">52週高値</span><span
                                                            class="value">@FormatPrice(stock.WeekHigh52)</span></div>
                                                            <div class="info-row"><span class="label">52週安値</span><span
                                                                class="value">@FormatPrice(stock.WeekLow52)</span></div>
                                                            </div>
                                                        </div>

                                                        <div class="detail-card card-stock">
                                                            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
                                                                <h3 style="margin:0;">株価情報</h3>
                                                                <button class="btn-refresh-sm" @onclick="async () => { _ = RefreshChart(); await RefreshPrice(); }"
                                                                        disabled="@isRefreshing">
                                                                    @(isRefreshing ? "取得中…" : "🔄 更新")
                                                                </button>
                                                            </div>
                                                            @if (priceError)
                                                            {
                                                                <div class="error-log-panel" style="margin-bottom:10px;">
                                                                    <div class="error-log-header">
                                                                        <span>⚠️ 株価取得エラー</span>
                                                                        <button class="error-log-clear" @onclick="ClearPriceError">✕</button>
                                                                    </div>
                                                                    <div class="error-log-body">
                                                                        <div class="error-log-line">@priceErrorMessage</div>
                                                                        <div class="error-log-line" style="margin-top:4px;">
                                                                            → <a href="@YahooUrl" target="_blank" rel="noopener noreferrer" style="color:#90caf9;">Yahoo
                                                                            Finance で確認 ↗</a>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                            <div class="chart-period-row">
                                                                @foreach (var p in new[] { "1M", "3M", "6M", "1Y" })
                                                                {
                                                                    var period = p;
                                                                    <button class="chart-period-btn @(chartPeriod == period ? "active" : "")"
                                                                            @onclick="() => chartPeriod = period">@period</button>
                                                                }
                                                            </div>
                                                            @{
                                                                var chartData = GetFilteredChartData();
                                                            }
                                                            @if (chartData.Count >= 2)
                                                            {
                                                                var cMin = chartData.Min(p => p.Close);
                                                                var cMax = chartData.Max(p => p.Close);
                                                                var line = BuildChartPoints(chartData, cMin, cMax);
                                                                var fill = line + $" {Sv(295)},{Sv(ChartYBottom)} {Sv(5)},{Sv(ChartYBottom)}";
                                                                var lastY = ChartPriceToY(chartData.Last().Close, cMin, cMax);
                                                                var up = chartData.Last().Close >= chartData.First().Close;
                                                                var stroke = up ? "#0066cc" : "#e03535";
                                                                var area = up ? "rgba(0,102,204,0.1)" : "rgba(224,53,53,0.08)";
                                                                <div class="chart-area">
                                                                    <svg viewBox="0 0 300 100" style="width:100%;height:140px;display:block;">
                                                                        <polyline points="@fill" fill="@area" stroke="none" />
                                                                        <polyline points="@line" fill="none" stroke="@stroke" stroke-width="1.8" />
                                                                        <circle cx="295" cy="@Sv(lastY)" r="3" fill="@stroke" />
                                                                        @SvgText(5, 13, "start", 9, "#888", cMax.ToString("N0"))
                                                                        @SvgText(5, 88, "start", 9, "#888", cMin.ToString("N0"))
                                                                    </svg>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="chart-placeholder">
                                                                    <span style="color:#aaa;font-size:13px;">
                                                                        @(isRefreshingChart ? "チャートデータを取得中…" : "📊 チャートデータ未取得")
                                                                    </span>
                                                                </div>
                                                            }
                                                            <div class="info-row">
                                                                <span class="label">始値</span>
                                                                <span class="value">@FormatPrice(stock.OpenPrice)</span>
                                                            </div>
                                                            <div class="info-row">
                                                                <span class="label">高値</span>
                                                                <span class="value"
                                                                      style="@(stock.HighPrice.HasValue ? "color:#e03535;" : "")">@FormatPrice(stock.HighPrice)</span>
                                                            </div>
                                                            <div class="info-row">
                                                                <span class="label">安値</span>
                                                                <span class="value"
                                                                      style="@(stock.LowPrice.HasValue ? "color:#1565c0;" : "")">@FormatPrice(stock.LowPrice)</span>
                                                            </div>
                                                            <div class="info-row">
                                                                <span class="label">前日終値</span>
                                                                <span class="value">@FormatPrice(stock.PreviousClose)</span>
                                                            </div>
                                                            <div class="info-row">
                                                                <span class="label">出来高</span>
                                                                <span class="value">@(stock.Volume.HasValue? stock.Volume.Value.ToString("N0") : "—")</span>
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(stock.LastUpdated))
                                                            {
                                                                <div style="font-size:10px;color:#bbb;margin-top:8px;text-align:right;">取得: @stock.LastUpdated</div>
                                                            }
                                                        </div>

                                                        <div class="company-overview-card card-overview">
                                                            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
                                                                <h3 style="margin:0;">企業概要</h3>
                                                                <button class="btn-refresh-sm" @onclick="RefreshSummary" disabled="@isRefreshingSummary">
                                                                    @(isRefreshingSummary ? "取得中…" : "🔄 更新")
                                                                </button>
                                                            </div>
                                                            @if (summaryError)
                                                            {
                                                                <div class="error-log-panel" style="margin-bottom:10px;">
                                                                    <div class="error-log-header">
                                                                        <span>⚠️ 企業概要取得エラー</span>
                                                                        <button class="error-log-clear" @onclick="() => summaryError = false">✕</button>
                                                                    </div>
                                                                    <div class="error-log-body">
                                                                        <div class="error-log-line">@summaryErrorMessage</div>
                                                                    </div>
                                                                </div>
                                                            }
                                                            @if (!string.IsNullOrEmpty(stock.CompanyDescription))
                                                            {
                                                                <p style="font-size:13px;color:#ccc;line-height:1.7;margin:0 0 12px;">@stock.CompanyDescription</p>
                                                            }
                                                            else if (!isRefreshingSummary)
                                                            {
                                                                <p style="color:#666;font-size:13px;margin:0 0 12px;">企業概要を取得するには更新ボタンを押してください。</p>
                                                            }
                                                            <div class="meta-row">
                                                                <span>従業員 <strong style="color:#ddd;">@(stock.Employees.HasValue ? $"{stock.Employees.Value:N0}人" :
                                                                                                                                                       "—")</strong></span>
                                                                    <span>所在地 <strong style="color:#ddd;">@FormatLocation(stock.CompanyCity,
                                                                                                                                                                        stock.CompanyCountry)</strong></span>
                                                                    </div>
                                                                </div>

                                                                <div class="dividend-card card-dividend">
                                                                    <div class="dividend-card-header">
                                                                        <h3>配当推移（過去5年）</h3>
                                                                        <div style="display:flex;align-items:center;gap:12px;">
                                                                            <div class="cagr-badge">
                                                                                <span class="cagr-label">CAGR（年平均成長率・当年除く）</span>
                                                                                <span class="cagr-value">@DivCagrText <span class="cagr-unit">/年</span></span>
                                                                            </div>
                                                                            <button class="btn-refresh-sm" @onclick="RefreshDividends" disabled="@isRefreshingDividends">
                                                                                @(isRefreshingDividends ? "取得中…" : "🔄 更新")
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                    @if (dividendError)
                                                                    {
                                                                        <div class="error-log-panel" style="margin-bottom:10px;">
                                                                            <div class="error-log-header">
                                                                                <span>⚠️ 配当データ取得エラー</span>
                                                                                <button class="error-log-clear" @onclick="() => dividendError = false">✕</button>
                                                                            </div>
                                                                            <div class="error-log-body">
                                                                                <div class="error-log-line">@dividendErrorMessage</div>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                    <div class="dividend-chart">
                                                                        @{
                                                                            var divBars = GetDivBars();
                                                                            var divGridLines = GetDivGridLines();
                                                                        }
                                                                        @if (divBars.Count > 0)
                                                                        {
                                                                            var hasBreakdown = divBars.Any(b => b.HasBreakdown);
                                                                            <svg viewBox="0 0 420 185" style="width:100%;height:auto;">
                                                                                @foreach (var gl in divGridLines)
                                                                                {
                                                                                    <line x1="36" y1="@Sv(gl.Y)" x2="400" y2="@Sv(gl.Y)" stroke="#f0f2f5" stroke-width="1" />
                                                                                    @SvgText(30, gl.Y + 4, "end", 9, "#bbb", gl.Label)
                                                                                }
                                                                                @foreach (var bar in divBars)
                                                                                {
                                                                                    @if (bar.HasBreakdown)
                                                                                    {
                                                                                        @if (bar.HInterim > 0.5)
                                                                                        {
                                                                                            <rect x="@bar.XInterim" y="@Sv(bar.YInterim)" width="28" height="@Sv(bar.HInterim)" fill="#64b5f6"
                                                                                                  rx="3" />
                                                                                            @SvgText(bar.XInterim + 14, bar.YInterim - 3, "middle", 8, "#aaa", bar.InterimAmt.ToString("N0"))
                                                                                        }
                                                                                        @if (bar.HFinal > 0.5)
                                                                                        {
                                                                                            <rect x="@bar.XFinal" y="@Sv(bar.YFinal)" width="28" height="@Sv(bar.HFinal)" fill="#1e88e5"
                                                                                                  rx="3" />
                                                                                            @SvgText(bar.XFinal + 14, bar.YFinal - 3, "middle", 8, "#ccc", bar.FinalAmt.ToString("N0"))
                                                                                        }
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <rect x="@bar.XInterim" y="@Sv(bar.YFinal)" width="60" height="@Sv(bar.HFinal)" fill="#1e88e5"
                                                                                              rx="3" />
                                                                                        @SvgText(bar.XInterim + 30, bar.YFinal - 3, "middle", 9, "#ccc", bar.Total.ToString("N0"), bold:
                                                                            true)
                                                                                    }
                                                                                    @SvgText(bar.XCenter, 145, "middle", 10, "#888", $"{bar.Year % 100:D2}年度")
                                                                                    @if (bar.IsCurrentYear)
                                                                                    {
                                                                                        @SvgText(bar.XCenter, 157, "middle", 8, "#e67e22", "(現時点)")
                                                                                    }
                                                                                }
                                                                                @if (hasBreakdown)
                                                                                {
                                                                                    <rect x="105" y="165" width="10" height="10" fill="#64b5f6" rx="2" />
                                                                                    @SvgText(118, 174, "start", 9, "#888", "中間配当")
                                                                                    <rect x="195" y="165" width="10" height="10" fill="#1e88e5" rx="2" />
                                                                                    @SvgText(208, 174, "start", 9, "#888", "期末配当")
                                                                                }
                                                                            </svg>
                                                                        }
                                                                        else if (isRefreshingDividends)
                                                                        {
                                                                            <div style="text-align:center;padding:30px 0;color:#888;font-size:13px;">配当データを取得中…</div>
                                                                        }
                                                                        else if (stock?.DividendHistory != null && stock.DividendHistory.Count == 0)
                                                                        {
                                                                            <div style="text-align:center;padding:30px 0;color:#888;font-size:13px;">配当データなし（無配または未対応銘柄）</div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div style="text-align:center;padding:30px 0;color:#666;font-size:13px;">配当データを取得するには更新ボタンを押してください。
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>

                                                        @* 共有MD選択モーダル *@
        @if (showSharedMdModal)
        {
            <div class="modal-overlay" @onclick="CloseSharedModal">
                <div class="modal-box" style="max-width:480px;width:92%;" @onclick:stopPropagation>
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
                        <h3 style="margin:0;font-size:16px;">共有MDファイル</h3>
                        <button class="btn-refresh-sm" @onclick="CloseSharedModal" style="padding:2px 10px;">✕</button>
                    </div>

                    @* アップロードセクション *@
                    <div style="border:1px solid #333;border-radius:8px;padding:12px;margin-bottom:14px;">
                        <p style="font-size:12px;color:#aaa;margin:0 0 10px;">ローカルのMDファイルをGitHubにアップロード</p>
                        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                            <InputFile id="gh-upload-input" OnChange="OnGhUploadFileSelected" accept=".md" style="display:none;" />
                            <label for="gh-upload-input" class="btn-refresh-sm" style="cursor:pointer;">📂 ファイル選択</label>
                            @if (!string.IsNullOrEmpty(uploadFileName))
                            {
                                <span style="font-size:12px;color:#ccc;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@uploadFileName</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(uploadFileName))
                        {
                            <div style="display:flex;gap:8px;align-items:center;margin-top:8px;">
                                <input class="settings-input" style="flex:1;font-size:12px;padding:4px 8px;"
                                       @bind="uploadSaveName" placeholder="保存ファイル名（.md）" />
                                <button class="btn-action-primary" style="font-size:12px;padding:4px 12px;"
                                        @onclick="UploadToGitHubAsync" disabled="@isUploading">
                                    @(isUploading ? "uploading…" : "📤 アップロード")
                                </button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(uploadMessage))
                        {
                            <div style="font-size:12px;margin-top:6px;color:@(uploadError ? "#e57373" : "#81c784");">@uploadMessage</div>
                        }
                    </div>

                    @* ファイル一覧セクション *@
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                        <span style="font-size:13px;color:#ccc;">アップロード済みファイル</span>
                        <button class="btn-refresh-sm" @onclick="LoadSharedFilesAsync" disabled="@isLoadingFiles" style="font-size:11px;">
                            @(isLoadingFiles ? "取得中…" : "🔄 更新")
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(sharedFilesError))
                    {
                        <div style="font-size:12px;color:#e57373;margin-bottom:8px;">@sharedFilesError</div>
                    }

                    @if (sharedFiles.Count == 0 && !isLoadingFiles)
                    {
                        <div style="text-align:center;padding:20px 0;color:#666;font-size:13px;">
                            @(string.IsNullOrEmpty(sharedFilesError) ? "ファイルがありません" : "")
                        </div>
                    }
                    else
                    {
                        <div style="max-height:240px;overflow-y:auto;">
                            @foreach (var file in sharedFiles)
                            {
                                var f = file;
                                <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 4px;border-bottom:1px solid #2a2a2a;">
                                    <span style="font-size:13px;color:#ddd;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@f.Name</span>
                                    <button class="btn-action-primary" style="font-size:11px;padding:3px 10px;margin-left:8px;"
                                            @onclick="() => ImportSharedFileAsync(f)" disabled="@isImporting">
                                        @(isImporting && importingFile == f.Name ? "取込中…" : "取込")
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <div class="detail-card card-md-memo">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
                <h3 style="margin:0;">MDメモ</h3>
                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                    <InputFile id="md-file-input" OnChange="OnMdFileSelected" accept=".md,.txt" style="display:none;" />
                    <label for="md-file-input" class="btn-refresh-sm" style="cursor:pointer;">📄 ローカル取込</label>
                    <button class="btn-refresh-sm" @onclick="OpenSharedModalAsync">☁ 共有から選択</button>
                    @if (!string.IsNullOrEmpty(stock.MdContent))
                    {
                        <button class="btn-refresh-sm" style="color:#e57373;" @onclick="ClearMdContent">✕ クリア</button>
                    }
                </div>
            </div>
            @if (!string.IsNullOrEmpty(stock.MdContent))
            {
                <div class="md-content">@((MarkupString)RenderMarkdown(stock.MdContent))</div>
            }
            else
            {
                <div style="text-align:center;padding:30px 0;color:#666;font-size:13px;">MDファイルを取り込むとここに表示されます。</div>
            }
        </div>

                                                        }
                                                        @* end else *@
                                                    </div>

@code {
    [Parameter] public string Code { get; set; } = "";

    private StockItem? stock;
    private List<StockItem> allStocks = [];
    private bool isRefreshing = false;
    private bool priceError = false;
    private string priceErrorMessage = "";
    private bool isRefreshingSummary = false;
    private bool summaryError = false;
    private string summaryErrorMessage = "";
    private bool isRefreshingDividends = false;
    private bool dividendError = false;
    private string dividendErrorMessage = "";
    private bool isRefreshingChart = false;
    private string chartPeriod = "3M";

    // 共有MDモーダル
    private bool showSharedMdModal = false;
    private List<GitHubFileInfo> sharedFiles = [];
    private string sharedFilesError = "";
    private bool isLoadingFiles = false;
    private bool isImporting = false;
    private string importingFile = "";
    // アップロード
    private string uploadFileName = "";
    private string uploadContent = "";
    private string uploadSaveName = "";
    private bool isUploading = false;
    private string uploadMessage = "";
    private bool uploadError = false;

    protected override async Task OnInitializedAsync()
    {
        allStocks = await StockSvc.GetAllAsync();
        stock = allStocks.FirstOrDefault(s => s.Code == Code);

        if (stock != null)
        {
            // 株価・チャート: 毎回取得
            _ = RefreshPrice();
            _ = RefreshChart();
            // 企業概要: 未取得のみ
            if (string.IsNullOrEmpty(stock.CompanyDescription))
                _ = RefreshSummary();
            // 配当: 未取得のみ
            if (stock.DividendHistory == null)
                _ = RefreshDividends();
        }
    }

    private bool IsAlarm => stock != null
        && !string.IsNullOrEmpty(stock.AlarmDate)
        && string.Compare(stock.AlarmDate, DateTime.Today.ToString("yyyy-MM-dd"), StringComparison.Ordinal) <= 0;

    private string YahooUrl => $"https://finance.yahoo.co.jp/quote/{Code}.T";
    private string MinkabuUrl => $"https://minkabu.jp/stock/{Code}";
    private string KabutanUrl => $"https://kabutan.jp/stock/?code={Code}";

    private async Task ToggleBuy()
    {
        if (stock == null) return;
        stock.IsBuyCandidate = !stock.IsBuyCandidate;
        await SaveAsync();
    }

    private async Task ToggleHold()
    {
        if (stock == null) return;
        stock.IsHolding = !stock.IsHolding;
        await SaveAsync();
    }

    private async Task RefreshPrice()
    {
        if (stock == null) return;
        isRefreshing = true;
        priceError = false;
        priceErrorMessage = "";
        StateHasChanged();

        var result = await ApiSvc.FetchQuoteAsync(stock.Code);
        if (result.Success && result.Quote != null)
        {
            var q = result.Quote;
            stock.CurrentPrice = q.Close;
            stock.PreviousClose = q.PreviousClose;
            stock.PriceChange = q.Change;
            stock.PriceChangeRate = q.ChangeRate;
            stock.PriceDirection = q.Direction;
            stock.OpenPrice = q.Open;
            stock.HighPrice = q.High;
            stock.LowPrice = q.Low;
            stock.Volume = q.Volume;
            stock.LastUpdated = q.LastUpdated;
            stock.Exchange = q.Exchange;
            stock.MarketCap = q.MarketCap;
            stock.LotSize = q.LotSize;
            stock.ForwardPE = q.ForwardPE;
            stock.PriceToBook = q.PriceToBook;
            stock.EPS = q.EPS;
            stock.BPS = q.BPS;
            stock.DividendYield = q.DividendYield;
            stock.DividendRate = q.DividendRate;
            stock.WeekHigh52 = q.WeekHigh52;
            stock.WeekLow52 = q.WeekLow52;
        }
        else
        {
            priceError = true;
            priceErrorMessage = result.Error ?? "不明なエラー";
        }

        isRefreshing = false;
        await SaveAsync();
    }

    private void ClearPriceError() { priceError = false; priceErrorMessage = ""; }

    private async Task RefreshSummary()
    {
        if (stock == null) return;
        isRefreshingSummary = true;
        summaryError = false;
        summaryErrorMessage = "";
        StateHasChanged();

        var result = await ApiSvc.FetchSummaryAsync(stock.Code);
        if (result.Success && result.Data != null)
        {
            var d = result.Data;
            stock.CompanyDescription = d.Description;
            stock.Employees = d.Employees;
            stock.CompanyCity = d.City;
            stock.CompanyCountry = d.Country;
            stock.NextEarningsDate = d.EarningsDate;
            await SaveAsync();
        }
        else
        {
            summaryError = true;
            summaryErrorMessage = result.Error ?? "不明なエラー";
        }

        isRefreshingSummary = false;
        StateHasChanged();
    }

    private async Task RefreshChart()
    {
        if (stock == null) return;
        isRefreshingChart = true;
        StateHasChanged();

        var result = await ApiSvc.FetchChartAsync(stock.Code);
        if (result.Success && result.Points != null)
        {
            stock.ChartData = result.Points;
            await SaveAsync();
        }

        isRefreshingChart = false;
        StateHasChanged();
    }

    // ---- チャート描画ヘルパー ----

    private const double ChartYTop = 8.0, ChartYBottom = 88.0;

    private List<ChartPoint> GetFilteredChartData()
    {
        var data = stock?.ChartData;
        if (data == null || data.Count == 0) return [];
        var cutoff = chartPeriod switch
        {
            "1M" => DateTime.Today.AddMonths(-1),
            "3M" => DateTime.Today.AddMonths(-3),
            "6M" => DateTime.Today.AddMonths(-6),
            _ => DateTime.MinValue,
        };
        if (cutoff == DateTime.MinValue) return data;
        return data.Where(p => DateTime.TryParse(p.Date, out var d) && d >= cutoff).ToList();
    }

    private static double ChartPriceToY(decimal price, decimal min, decimal max)
    {
        if (max == min) return (ChartYTop + ChartYBottom) / 2;
        return ChartYBottom - (double)((price - min) / (max - min)) * (ChartYBottom - ChartYTop);
    }

    private string BuildChartPoints(List<ChartPoint> data, decimal min, decimal max)
    {
        var n = data.Count - 1;
        return string.Join(" ", data.Select((p, i) =>
            $"{Sv(5 + (double)i / n * 290)},{Sv(ChartPriceToY(p.Close, min, max))}"));
    }

    private async Task RefreshDividends()
    {
        if (stock == null) return;
        isRefreshingDividends = true;
        dividendError = false;
        dividendErrorMessage = "";
        StateHasChanged();

        var result = await ApiSvc.FetchDividendsAsync(stock.Code);
        if (result.Success && result.Items != null)
        {
            stock.DividendHistory = result.Items;
            await SaveAsync();
        }
        else
        {
            dividendError = true;
            dividendErrorMessage = result.Error ?? "不明なエラー";
        }

        isRefreshingDividends = false;
        StateHasChanged();
    }

    // ---- 配当チャート用ヘルパー ----

    // XInterim/XFinal: 各棒のX座標、XCenter: 年ラベル中心
    private record DivGroupedBar(
        int XInterim, int XFinal, int XCenter,
        double YInterim, double HInterim,
        double YFinal, double HFinal,
        int Year, decimal Total, decimal InterimAmt, decimal FinalAmt,
        bool IsCurrentYear, bool HasBreakdown);

    // 各年グループのX開始位置（グループ幅72px、5グループ）
    private static readonly int[] DivGroupX = [36, 108, 180, 252, 324];
    private const double DivBottom = 130.0;
    private const double DivHeight = 110.0;

    private List<DivGroupedBar> GetDivBars()
    {
        var data = stock?.DividendHistory;
        if (data == null || data.Count == 0) return [];
        var max = data.Max(d => d.Amount);
        if (max <= 0) return [];
        var offset = 5 - data.Count;
        // 現在の年度（4月始まり）
        var today = DateTime.Today;
        var currentFiscalYear = today.Month >= 4 ? today.Year : today.Year - 1;
        return data.Select((d, i) =>
        {
            var hasBreakdown = d.InterimAmount > 0 && d.FinalAmount > 0;
            var interim = hasBreakdown ? d.InterimAmount : 0m;
            var final_ = hasBreakdown ? d.FinalAmount : d.Amount;
            var hInterim = (double)(interim / max) * DivHeight;
            var hFinal = (double)(final_ / max) * DivHeight;
            var gx = DivGroupX[offset + i];
            return new DivGroupedBar(
                gx + 6, gx + 38, gx + 36,
                DivBottom - hInterim, hInterim,
                DivBottom - hFinal, hFinal,
                d.Year, d.Amount, interim, final_,
                d.Year == currentFiscalYear, hasBreakdown);
        }).ToList();
    }

    private List<(double Y, string Label)> GetDivGridLines()
    {
        var data = stock?.DividendHistory;
        if (data == null || data.Count == 0) return [];
        var max = data.Max(d => d.Amount);
        if (max <= 0) return [];
        return
        [
            (DivBottom - DivHeight * 0.25, (max * 0.25m).ToString("N0")),
            (DivBottom - DivHeight * 0.50, (max * 0.50m).ToString("N0")),
            (DivBottom - DivHeight * 0.75, (max * 0.75m).ToString("N0")),
            (DivBottom - DivHeight, max.ToString("N0")),
        ];
    }

    private string DivCagrText
    {
        get
        {
            var data = stock?.DividendHistory;
            if (data == null) return "—";
            var today = DateTime.Today;
            var currentFiscalYear = today.Month >= 4 ? today.Year : today.Year - 1;
            var filtered = data.Where(d => d.Year < currentFiscalYear).ToList();
            if (filtered.Count < 2) return "—";
            var first = (double)filtered.First().Amount;
            var last = (double)filtered.Last().Amount;
            if (first <= 0) return "—";
            var cagr = Math.Pow(last / first, 1.0 / (filtered.Count - 1)) - 1;
            return $"{(cagr >= 0 ? "+" : "")}{cagr * 100:F1}%";
        }
    }

    // SVG 属性用：InvariantCulture で小数点をドットに統一
    private static string Sv(double v) =>
        v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    // Razor が <text> をキーワードと解釈するため MarkupString で SVG text 要素を生成
    private static MarkupString SvgText(double x, double y, string anchor, int size, string fill, string content, bool bold
= false)
    {
        var ic = System.Globalization.CultureInfo.InvariantCulture;
        var fw = bold ? " font-weight=\"600\"" : "";
        return (MarkupString)$"<text x=\"{x.ToString("F1", ic)}\" y=\"{y.ToString("F1", ic)}\" text-anchor=\"{anchor}\" font-size=\"{size}\"{fw} fill=\"{fill}\">{System.Web.HttpUtility.HtmlEncode(content)}</text>";
    }

    private static string FormatEarningsDate(string? date)
    {
        if (string.IsNullOrEmpty(date)) return "—";
        return DateTime.TryParse(date, out var d) ? d.ToString("yyyy年M月d日") : date;
    }

    private static string EarningsDateStyle(string? date)
    {
        if (string.IsNullOrEmpty(date) || !DateTime.TryParse(date, out var d)) return "";
        var days = (d.Date - DateTime.Today).TotalDays;
        return days >= 0 && days <= 31 ? "color:#e03535;font-weight:700;" : "";
    }

    private static string FormatPrice(decimal? price)
        => price.HasValue ? $"¥{price.Value:N0}" : "—";

    private static string FormatDecimal(decimal? value, string unit)
        => value.HasValue ? $"{value.Value:N2} {unit}" : "—";

    private static string FormatPercent(decimal? value)
        => value.HasValue ? $"{value.Value * 100:F2}%" : "—";

    private static string FormatMarketCap(long? cap)
    {
        if (!cap.HasValue) return "—";
        if (cap.Value >= 1_0000_0000_0000)
            return $"{cap.Value / 1_0000_0000_0000.0:F1}兆円";
        if (cap.Value >= 1_0000_0000)
            return $"{cap.Value / 1_0000_0000.0:F0}億円";
        return $"{cap.Value / 1_0000.0:F0}万円";
    }

    private static string FormatMinPurchase(decimal? price, int? lotSize)
    {
        if (!price.HasValue || !lotSize.HasValue) return "—";
        return $"¥{price.Value * lotSize.Value:N0}";
    }

    private static string FormatLocation(string? city, string? country)
    {
        if (string.IsNullOrEmpty(city) && string.IsNullOrEmpty(country)) return "—";
        if (string.IsNullOrEmpty(city)) return country!;
        if (string.IsNullOrEmpty(country)) return city;
        return $"{city}, {country}";
    }

    private void GoBack() => Nav.NavigateTo("");

    private async Task OnMdFileSelected(InputFileChangeEventArgs e)
    {
        if (stock == null) return;
        var file = e.File;
        using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024);
        using var reader = new StreamReader(stream);
        stock.MdContent = await reader.ReadToEndAsync();
        await SaveAsync();
    }

    private async Task ClearMdContent()
    {
        if (stock == null) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", "MDメモをクリアしますか？");
        if (!confirmed) return;
        stock.MdContent = null;
        await SaveAsync();
    }

    private static string RenderMarkdown(string markdown)
    {
        var pipeline = new Markdig.MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .DisableHtml()
            .Build();
        return Markdig.Markdown.ToHtml(markdown, pipeline);
    }

    private async Task SaveAsync()
    {
        if (stock == null) return;
        var idx = allStocks.FindIndex(s => s.Code == Code);
        if (idx >= 0) allStocks[idx] = stock;
        await StockSvc.SaveAsync(allStocks);
    }

    // ---- 共有MDモーダル ----

    private async Task OpenSharedModalAsync()
    {
        showSharedMdModal = true;
        await LoadSharedFilesAsync();
    }

    private void CloseSharedModal()
    {
        showSharedMdModal = false;
        uploadFileName = "";
        uploadContent = "";
        uploadSaveName = "";
        uploadMessage = "";
    }

    private async Task LoadSharedFilesAsync()
    {
        isLoadingFiles = true;
        sharedFilesError = "";
        StateHasChanged();

        var (files, error) = await GhSvc.ListFilesAsync();
        sharedFiles = files;
        sharedFilesError = error ?? "";
        isLoadingFiles = false;
        StateHasChanged();
    }

    private async Task ImportSharedFileAsync(GitHubFileInfo file)
    {
        if (stock == null) return;
        isImporting = true;
        importingFile = file.Name;
        StateHasChanged();

        var (content, error) = await GhSvc.DownloadFileAsync(file.Path);
        if (error != null)
        {
            sharedFilesError = $"取込失敗: {error}";
        }
        else
        {
            stock.MdContent = content;
            await SaveAsync();
            showSharedMdModal = false;
        }

        isImporting = false;
        importingFile = "";
        StateHasChanged();
    }

    private async Task OnGhUploadFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        uploadMessage = "";
        uploadError = false;
        uploadContent = "";
        uploadFileName = "";
        uploadSaveName = "";

        if (!file.Name.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
        {
            uploadMessage = "ファイル形式が正しくありません。.md ファイルを選択してください。";
            uploadError = true;
            return;
        }

        const long maxSize = 100 * 1024;
        if (file.Size > maxSize)
        {
            uploadMessage = $"ファイルサイズが上限を超えています（{file.Size / 1024}KB / 上限100KB）。";
            uploadError = true;
            return;
        }

        using var stream = file.OpenReadStream(maxAllowedSize: maxSize);
        using var reader = new StreamReader(stream);
        uploadContent = await reader.ReadToEndAsync();
        uploadFileName = file.Name;
        uploadSaveName = file.Name;
    }

    private async Task UploadToGitHubAsync()
    {
        if (string.IsNullOrWhiteSpace(uploadContent)) return;
        var name = uploadSaveName.Trim();
        if (!name.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
            name += ".md";

        isUploading = true;
        uploadMessage = "";
        StateHasChanged();

        var error = await GhSvc.UploadFileAsync(name, uploadContent);
        if (error != null)
        {
            uploadMessage = error;
            uploadError = true;
        }
        else
        {
            uploadMessage = $"「{name}」をアップロードしました。";
            uploadError = false;
            await LoadSharedFilesAsync();
        }

        isUploading = false;
        StateHasChanged();
    }
}
