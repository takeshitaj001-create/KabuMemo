{
  // エディター
  "editor.formatOnSave": true,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.rulers": [120],

  // C# / Blazor
  "dotnet.defaultSolution": "KabuMemo.csproj",
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },
  "[razor]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },

  // ファイル
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.exclude": {
    "**/obj": true,
    "**/bin": true
  },

  // 検索除外
  "search.exclude": {
    "**/obj": true,
    "**/bin": true
  }
}
