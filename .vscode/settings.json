{
  // エディター
  "editor.formatOnSave": false,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.rulers": [
    120
  ],
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },
  "[razor]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.formatOnSave": false
  },

  // ファイル
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.exclude": {
    "**/obj": true,
    "**/bin": true
  },

  // 検索除外
  "search.exclude": {
    "**/obj": true,
    "**/bin": true
  }
}
