@inject NavigationManager Nav

@if (isOpen)
{
    <div class="nav-overlay" @onclick="Close">
        <div class="nav-menu-panel" @onclick:stopPropagation>
            <div class="nav-menu-header">
                <span>メニュー</span>
                <button class="btn-close-nav" @onclick="Close">✕</button>
            </div>
            <nav class="nav-menu-items">
                <NavLink class="nav-menu-link" href="" Match="NavLinkMatch.All" @onclick="Close">
                    🏠 ホーム
                </NavLink>
                <NavLink class="nav-menu-link" href="disclosures" @onclick="Close">
                    📰 IR情報一覧
                </NavLink>
                <a href="https://fx.minkabu.jp/indicators" target="_blank" rel="noopener noreferrer"
                   class="nav-menu-link" @onclick="Close">
                    📅 経済指標カレンダー
                </a>
                <a href="https://inav.ice.com/tse/iopv/table?language=jp" target="_blank" rel="noopener noreferrer"
                   class="nav-menu-link" @onclick="Close">
                    📈 ETFの推定価値を確認
                </a>
                <a href="https://www.release.tdnet.info/inbs/I_main_00.html" target="_blank" rel="noopener noreferrer"
                   class="nav-menu-link" @onclick="Close">
                    📢 適時開示情報閲覧サービス
                </a>
                <hr class="nav-divider" />
                <NavLink class="nav-menu-link" href="watchlists" @onclick="Close">
                    📁 ウォッチリスト管理
                </NavLink>
                <button class="nav-menu-link" @onclick="OnImportClick">
                    📂 ファイルからデータ登録
                </button>
                <button class="nav-menu-link" @onclick="OnCsvClick">
                    📋 銘柄データをCSVで編集
                </button>
                <NavLink class="nav-menu-link" href="settings" @onclick="Close">
                    ☁ GitHub 共有設定
                </NavLink>
            </nav>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnCsvModalOpen { get; set; }
    [Parameter] public EventCallback OnImportModalOpen { get; set; }

    private bool isOpen = false;

    public void Open()
    {
        isOpen = true;
        StateHasChanged();
    }

    public void Close()
    {
        isOpen = false;
        StateHasChanged();
    }

    private async Task OnCsvClick()
    {
        Close();
        await OnCsvModalOpen.InvokeAsync();
    }

    private async Task OnImportClick()
    {
        Close();
        await OnImportModalOpen.InvokeAsync();
    }
}
